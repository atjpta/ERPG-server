{
    "private": true,
    "name": "erpg-server",
    "version": "0.0.1",
    "description": "ERPG — pixel top-down MMORPG server (Colyseus) cho Android (Google Play) + PC",
    "type": "module",
    "main": "build/index.js",
    "engines": {
        "node": ">= 24.x"
    },
    "scripts": {
        "dev": "dotenvx run -f .env.development -- tsx watch src/index.ts",
        "build": "yarn clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "start": "node build/index.js",
        "start:dev": "dotenvx run -f .env.development -- node build/index.js",
        "clean": "rimraf build",
        "typecheck": "tsc --noEmit",
        "smoke": "tsx scripts/smoke-test.ts",
        "test:tokens": "node scripts/local-test-tokens.mjs",
        "kick-test": "tsx scripts/kick-test.ts",
        "test": "mocha --import=tsx --file test/setup.ts \"test/**/*.test.ts\" --exit --timeout 15000",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "seed": "dotenvx run -f .env.development -- tsx src/seeds/index.ts ../ERPG/Assets/ERPG/Resources/Config",
        "db:studio": "dotenvx run -f .env.development -- drizzle-kit studio",
        "db:generate": "dotenvx run -f .env.development -- drizzle-kit generate",
        "db:migrate": "dotenvx run -f .env.development -- drizzle-kit migrate",
        "db:push": "dotenvx run -f .env.development -- drizzle-kit push",
        "schema:generate": "node scripts/generate-room-schemas.mjs ../ERPG/Assets/ERPG/Scripts/Schema",
        "config:export": "dotenvx run -f .env.development -- tsx scripts/export-client-config.ts ../ERPG/Assets/ERPG/Resources/Config",
        "env:dev:decrypt": "dotenvx decrypt -f .env.development",
        "env:dev:encrypt": "dotenvx encrypt -f .env.development",
        "env:prod:decrypt": "dotenvx decrypt -f .env.production",
        "env:prod:encrypt": "dotenvx encrypt -f .env.production",
        "prepare": "husky"
    },
    "license": "UNLICENSED",
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "resolutions": {
        "uWebSockets.js": "https://github.com/uNetworking/uWebSockets.js/archive/refs/tags/v20.70.0.tar.gz"
    },
    "dependencies": {
        "@colyseus/better-call": "^1.3.3",
        "@colyseus/command": "^0.3.2",
        "@colyseus/redis-driver": "^0.18.4",
        "@colyseus/schema": "^5.0.34",
        "@colyseus/tools": "^0.18.4",
        "@colyseus/uwebsockets-transport": "^0.18.4",
        "@dotenvx/dotenvx": "^2.30.0",
        "bcryptjs": "^3.0.3",
        "bignumber.js": "^11.1.5",
        "colyseus": "^0.18.8",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "google-auth-library": "^11.1.0",
        "jsonwebtoken": "^9.0.3",
        "luxon": "^3.7.2",
        "postgres": "^3.4.9",
        "redis": "^6.2.1",
        "uuid": "^14.0.2",
        "uwebsockets-express": "^2.0.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@colyseus/sdk": "^0.18.4",
        "@colyseus/testing": "^0.18.6",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "mocha": "^12.0.2",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.5",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    }
}
