{
    "compilerOptions": {
        "outDir": "build",
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "allowJs": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "scripts", "drizzle.config.ts"]
}
