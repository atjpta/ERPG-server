NODE_ENV=development
PORT=2567
TZ=Asia/Ho_Chi_Minh
# URL public của server — link trang xoá tài khoản khai báo trên Google Play: <PUBLIC_URL>/account-deletion
PUBLIC_URL=http://localhost:2567
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/erpg
# Bật khi scale nhiều process (RedisDriver + RedisPresence + cache/rate limit dùng chung)
# REDIS_URI=redis://localhost:6379
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-admin

# Google Cloud Console → Credentials → OAuth client loại "Web application" (cùng project với Play Games)
# Dùng để đổi serverAuthCode của Play Games Services v2 và làm `aud` của Google idToken.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Client ID khác được chấp nhận cho idToken (vd Desktop Client ID của bản PC), phân tách bằng dấu phẩy
GOOGLE_EXTRA_CLIENT_IDS=

# Origin trình duyệt được gọi API (trang admin...). Rỗng = mọi origin (chỉ dùng ở dev)
CORS_ORIGINS=
# true khi chạy sau Nginx/Cloudflare — lấy IP thật để rate limit
TRUST_PROXY=false
